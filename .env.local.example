# Copy to .env.local to control where terrain tiles come from.
#
#   local   - loose PNG pyramid in public/tiles/terrain/  (npm run fetch:terrain)
#   pmtiles - single packed archive public/tiles/terrain.pmtiles (npm run pack:pmtiles)
#   remote  - live AWS Open Data bucket (the default if this file is absent;
#             slow, re-fetches ~2,024 tiles per session)
#
# Development should always have this set to `local` (or `pmtiles`).
VITE_TILE_MODE=local

# Baked procedural surface texture draped over the terrain. Optional — the app
# renders fine without it.
#
#   off     - no texture layer (the default if unset)
#   local   - loose PNG pyramid in public/tiles/texture/   (npm run generate:texture)
#   pmtiles - single packed archive public/tiles/texture.pmtiles (npm run pack:texture)
#
# z10-12 island-wide, z13-14 over the central highlands. Needs MAX_ZOOM 14 to
# show the finest band.
# VITE_TEXTURE_MODE=pmtiles
