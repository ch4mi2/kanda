# Copy to .env.local to control where terrain tiles come from.
#
#   local   - loose PNG pyramid in public/tiles/terrain/  (npm run fetch:terrain)
#   pmtiles - single packed archive public/tiles/terrain.pmtiles (npm run pack:pmtiles)
#   remote  - live AWS Open Data bucket (the default if this file is absent;
#             slow, re-fetches ~2,024 tiles per session)
#
# Development should always have this set to `local` (or `pmtiles`).
VITE_TILE_MODE=local
