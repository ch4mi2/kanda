{
  "name": "kanda",
  "version": "0.0.0",
  "type": "module",
  "description": "A peak-identification and orientation tool for Sri Lanka — stand on a summit, look around, and the map names what you're seeing.",
  "license": "MIT",
  "author": "Chamithu Thamara",
  "homepage": "https://kanda.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ch4mi2/kanda.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "fetch:peaks": "node scripts/fetch-peaks.mjs",
    "fetch:osm": "node scripts/fetch-osm-features.mjs",
    "fetch:terrain": "node scripts/fetch-terrain.mjs",
    "repair:dem": "node scripts/repair-dem.mjs --repair --smooth",
    "pack:pmtiles": "node scripts/pack-pmtiles.mjs",
    "generate:masks": "node scripts/generate-masks.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
